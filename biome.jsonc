{
  "extends": [
    "ultracite/biome/core",
    "ultracite/biome/vue",
    "ultracite/biome/tanstack",
    "ultracite/biome/vitest"
  ],
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "linter": {
    "rules": {
      "a11y": {
        // Our @ap/ui form controls render native labelable elements
        // (input/select/button), so <label><Input/></label> associates
        // correctly — teach the rule the component names.
        "noLabelWithoutControl": {
          "level": "error",
          "options": {
            "inputComponents": ["Input", "NativeSelect", "Switch"]
          }
        }
      }
    }
  },
  "overrides": [
    {
      "includes": ["apps/*/src/pages/**"],
      "linter": {
        "rules": {
          "style": { "useVueMultiWordComponentNames": "off" }
        }
      }
    },
    {
      "includes": ["apps/dashboard/**"],
      "assist": { "enabled": false },
      "linter": {
        "rules": {
          "a11y": "warn",
          "complexity": "warn",
          "correctness": {
            "noUndeclaredVariables": "off",
            "noUnknownPseudoClass": "warn",
            "noUnusedVariables": "warn",
            "noVueDuplicateKeys": "warn"
          },
          "nursery": {
            "useSortedClasses": "off"
          },
          "performance": {
            "noBarrelFile": "off"
          },
          "style": {
            "noIncrementDecrement": "warn",
            "noNegationElse": "warn",
            "noNonNullAssertion": "warn",
            "noRestrictedGlobals": "warn",
            "noUnusedTemplateLiteral": "warn",
            "useConsistentArrowReturn": "warn",
            "useDefaultSwitchClause": "warn",
            "useDestructuring": "warn",
            "useFilenamingConvention": "off",
            "useSymbolDescription": "warn",
            "useVueMultiWordComponentNames": "off"
          },
          "suspicious": {
            "noAlert": "warn",
            "noBitwiseOperators": "warn",
            "noDocumentCookie": "warn",
            "noDuplicateCustomProperties": "warn",
            "noEmptyBlockStatements": "warn",
            "noEmptySource": "warn",
            "noExplicitAny": "warn",
            "noGlobalAssign": "warn",
            "noReturnAssign": "warn",
            "noShadow": "warn",
            "noShadowRestrictedNames": "warn",
            "noUnusedExpressions": "warn",
            "useIterableCallbackReturn": "warn",
            "useStrictMode": "off"
          }
        }
      }
    },
    {
      // Generated by the VueRouter/AutoImport vite plugins — don't lint;
      // fixing them just fights the generator. Last entry: later overrides win.
      "includes": ["apps/dashboard/src/types/*.d.ts"],
      "linter": { "enabled": false }
    }
  ]
}
