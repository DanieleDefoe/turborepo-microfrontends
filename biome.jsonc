{
  "extends": [
    "ultracite/biome/core",
    "ultracite/biome/vue",
    "ultracite/biome/tanstack",
    "ultracite/biome/vitest"
  ],
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "linter": {
    "rules": {
      "a11y": {
        // Our @ap/ui form controls render native labelable elements
        // (input/select/button), so <label><Input/></label> associates
        // correctly — teach the rule the component names.
        "noLabelWithoutControl": {
          "level": "error",
          "options": {
            "inputComponents": ["Input", "NativeSelect", "Switch"]
          }
        }
      }
    }
  },
  "overrides": [
    {
      "includes": ["apps/*/src/pages/**"],
      "linter": {
        "rules": {
          "style": { "useVueMultiWordComponentNames": "off" }
        }
      }
    },
    {
      // Biome doesn't model Vue template scope (props are implicitly in
      // template scope after defineProps; v-slot creates bindings), so this
      // rule false-positives in SFCs. vue-tsc type-checks templates and
      // catches genuinely undeclared identifiers.
      "includes": ["**/*.vue"],
      "linter": {
        "rules": {
          "correctness": { "noUndeclaredVariables": "off" }
        }
      }
    },
    {
      // packages/ui is our shadcn-vue kit; these conventions are load-bearing:
      // PascalCase SFC filenames + single-word names come from the shadcn
      // generator (and keep upstream diffs clean), the index.ts barrels ARE the
      // package's exports API, and cva class strings stay unsorted to match
      // upstream. Everything else stays at full strictness.
      "includes": ["packages/ui/**"],
      "linter": {
        "rules": {
          "nursery": { "useSortedClasses": "off" },
          "performance": { "noBarrelFile": "off" },
          "style": {
            "useFilenamingConvention": "off",
            "useVueMultiWordComponentNames": "off"
          }
        }
      }
    },
    {
      "includes": ["apps/dashboard/**"],
      "assist": { "enabled": false },
      "linter": {
        "rules": {
          "a11y": "warn",
          "complexity": "warn",
          "correctness": {
            "noUndeclaredVariables": "off",
            "noUnknownPseudoClass": "warn",
            "noUnusedVariables": "warn",
            "noVueDuplicateKeys": "warn"
          },
          "nursery": {
            "useSortedClasses": "off"
          },
          "performance": {
            "noBarrelFile": "off"
          },
          "style": {
            "noIncrementDecrement": "warn",
            "noNegationElse": "warn",
            "noNonNullAssertion": "warn",
            "noRestrictedGlobals": "warn",
            "noUnusedTemplateLiteral": "warn",
            "useConsistentArrowReturn": "warn",
            "useDefaultSwitchClause": "warn",
            "useDestructuring": "warn",
            "useFilenamingConvention": "off",
            "useSymbolDescription": "warn",
            "useVueMultiWordComponentNames": "off"
          },
          "suspicious": {
            "noAlert": "warn",
            "noBitwiseOperators": "warn",
            "noDocumentCookie": "warn",
            "noDuplicateCustomProperties": "warn",
            "noEmptyBlockStatements": "warn",
            "noEmptySource": "warn",
            "noExplicitAny": "warn",
            "noGlobalAssign": "warn",
            "noReturnAssign": "warn",
            "noShadow": "warn",
            "noShadowRestrictedNames": "warn",
            "noUnusedExpressions": "warn",
            "useIterableCallbackReturn": "warn",
            "useStrictMode": "off"
          }
        }
      }
    },
    {
      // Generated by the VueRouter/AutoImport vite plugins — don't lint;
      // fixing them just fights the generator. Last entry: later overrides win.
      "includes": ["apps/dashboard/src/types/*.d.ts"],
      "linter": { "enabled": false }
    }
  ]
}
