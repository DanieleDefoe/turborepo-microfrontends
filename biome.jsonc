{
  "extends": [
    "ultracite/biome/core",
    "ultracite/biome/vue",
    "ultracite/biome/tanstack",
    "ultracite/biome/vitest"
  ],
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "overrides": [
    {
      // Generated by the VueRouter/AutoImport vite plugins — don't lint;
      // fixing them just fights the generator.
      "includes": ["apps/dashboard/src/types/*.d.ts"],
      "linter": { "enabled": false }
    },
    {
      // apps/dashboard is the vendored shadcn-vue-admin template.
      // "off"  = rule conflicts with the template's architecture (vue-router file
      //          conventions, unplugin auto-imports that vue-tsc already checks,
      //          shadcn barrels/PascalCase, vendored tailwind class strings).
      // "warn" = pre-existing quality findings, grandfathered: visible, fix when
      //          you touch the file, but not commit-blocking. Rules not listed
      //          here stay errors, so new violation kinds in new code still block.
      "includes": ["apps/dashboard/**"],
      "assist": { "enabled": false },
      "linter": {
        "rules": {
          // Pre-existing template a11y findings incl. raw .svg assets — warn,
          // not off: keep them visible until fixed.
          "a11y": "warn",
          "complexity": "warn",
          "correctness": {
            "noUndeclaredVariables": "off",
            "noUnknownPseudoClass": "warn",
            "noUnusedVariables": "warn",
            "noVueDuplicateKeys": "warn"
          },
          "nursery": {
            "useSortedClasses": "off"
          },
          "performance": {
            "noBarrelFile": "off"
          },
          "style": {
            "noIncrementDecrement": "warn",
            "noNegationElse": "warn",
            "noNonNullAssertion": "warn",
            "noRestrictedGlobals": "warn",
            "noUnusedTemplateLiteral": "warn",
            "useConsistentArrowReturn": "warn",
            "useDefaultSwitchClause": "warn",
            "useDestructuring": "warn",
            "useFilenamingConvention": "off",
            "useSymbolDescription": "warn",
            "useVueMultiWordComponentNames": "off"
          },
          "suspicious": {
            "noAlert": "warn",
            "noBitwiseOperators": "warn",
            "noDocumentCookie": "warn",
            "noDuplicateCustomProperties": "warn",
            "noEmptyBlockStatements": "warn",
            "noEmptySource": "warn",
            "noExplicitAny": "warn",
            "noGlobalAssign": "warn",
            "noReturnAssign": "warn",
            "noShadow": "warn",
            "noShadowRestrictedNames": "warn",
            "noUnusedExpressions": "warn",
            "useIterableCallbackReturn": "warn",
            "useStrictMode": "off"
          }
        }
      }
    }
  ]
}
